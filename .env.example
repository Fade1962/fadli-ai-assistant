# Telegram
TELEGRAM_TOKEN=
CHAT_ID=

# AI providers - isi minimal satu
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

AI_PROVIDER_ORDER=openai,gemini,groq,openrouter

# Model dapat diganti tanpa edit source
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-5.6-luna
OPENROUTER_MODEL=openrouter/free
GEMINI_MODEL=gemini-2.5-flash

# WITA
TIMEZONE=Asia/Makassar

# Daily Intelligence
DAILY_SCOUT_ENABLED=true
DAILY_SCOUT_TIME=06:00
DAILY_SCOUT_TOPICS=Indonesia ekonomi,AI teknologi Indonesia,marketing digital Indonesia,otomotif Indonesia,bisnis Indonesia

# Gunakan path persistent volume di production, mis. /data
DATA_DIR=./data

# Limits
MAX_SESSION_FILES=50
MAX_TELEGRAM_DOWNLOAD_MB=20
PDF_OCR_FALLBACK=true
PDF_OCR_MAX_PAGES=20
MAX_FILE_CONTEXT_CHARS=60000
MAX_CHUNK_CHARS=5000
