# Telegram
TELEGRAM_TOKEN=
CHAT_ID=

# FREE AI providers only
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# NARA identity
ASSISTANT_NAME=NARA
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Current free-tier models/routes
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_WEB_MODEL=groq/compound
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free

# Put the REAL personal profile in GitHub Secret PERSONAL_PROFILE_JSON, not in this file.
PERSONAL_PROFILE_JSON={}

TIMEZONE=Asia/Makassar
DIGEST_TIME=06:00
DATA_DIR=/app/data
MAX_CONTEXT_CHARS=60000
RECENT_FILE_LIMIT=20
RECENT_HISTORY_LIMIT=12

# Privacy: do not send injected health/family/finance profile to fallback providers by default
ALLOW_SENSITIVE_FALLBACK=false
