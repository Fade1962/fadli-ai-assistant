# =========================
# TELEGRAM
# =========================
TELEGRAM_TOKEN=
CHAT_ID=

# =========================
# FREE AI PROVIDERS
# =========================
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# =========================
# NARA IDENTITY
# =========================
ASSISTANT_NAME=NARA

# Prioritas AI:
# 1. Gemini
# 2. Groq
# 3. OpenRouter
AI_PROVIDER_ORDER=gemini,groq,openrouter

# =========================
# AI MODELS
# =========================
GEMINI_MODEL=gemini-2.5-flash

GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_WEB_MODEL=groq/compound

OPENROUTER_MODEL=openrouter/free

# =========================
# PERSONAL PROFILE
# =========================
# Jangan isi data pribadi asli di file ini.
# Simpan profil asli di GitHub Secret:
# PERSONAL_PROFILE_JSON
PERSONAL_PROFILE_JSON={}

# =========================
# TIMEZONE
# =========================
TIMEZONE=Asia/Makassar

# Daily Radar jam 06.00 WITA
DIGEST_TIME=06:00

# =========================
# DATA / MEMORY
# =========================
DATA_DIR=./data

RECENT_HISTORY_LIMIT=12
RECENT_FILE_LIMIT=20
MAX_CONTEXT_CHARS=60000

# =========================
# DAILY RADAR
# =========================
DAILY_RADAR_ENABLED=true
DAILY_RADAR_MAX_ITEMS=4

# Berita 1-3/10 akan sangat diturunkan prioritasnya
RADAR_LOW_RATING_THRESHOLD=3

# Berita 8-10/10 akan lebih diprioritaskan
RADAR_HIGH_RATING_THRESHOLD=8

# =========================
# PRIVACY
# =========================
# Jika konteks mengandung data sensitif keluarga,
# kesehatan, atau keuangan, jangan otomatis
# meneruskan ke fallback provider lain.
ALLOW_SENSITIVE_FALLBACK=false
